node_modules/
dist/
coverage/
.DS_Store
*.log

plans/

# Personal agent permissions. `.claude/settings.json` is shared config; only the
# per-machine allowlist is ignored.
.claude/settings.local.json

# Signing material. This repo is public, and although keys are minted from the
# projects monorepo rather than here, an accidental copy costs the same: the
# licence signing key is compiled into every shipped bundle as its public half,
# so leaking the private half means releasing all four products and re-signing
# every customer key.
keys.json
*.pkcs8
*.pem

# The geometry packs in /geo are committed on purpose. They are generated by
# `npm run data:build`, but that needs network and a 39 MB Natural Earth download,
# and someone who has just cloned the repo should be able to run the examples and
# read the data straight away. Regenerating is for refreshing a source, not for
# first use.
#
# The raw downloads behind them are not committed.
/.geo-cache/

# Leading slashes matter above and below: an unanchored `geo/` would also match
# `src/geo/`, quietly leaving five source files untracked and hiding them from
# every tool that honours .gitignore (prettier 3 does).
