{
  "name": "vue-apexmaps",
  "version": "0.3.0",
  "type": "module",
  "description": "Vue 3 component for ApexMaps",
  "main": "dist/vue-apexmaps.cjs",
  "module": "dist/vue-apexmaps.esm.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/vue-apexmaps.esm.js",
      "require": "./dist/vue-apexmaps.cjs",
      "default": "./dist/vue-apexmaps.cjs"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "apexmaps": "^0.3.0",
    "vue": ">=3.3.0"
  },
  "scripts": {
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "rollup -c && npm run build:types",
    "build:types": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build && node ../../scripts/check-wrappers.mjs vue"
  },
  "keywords": [
    "apexmaps",
    "vue",
    "vue3",
    "maps",
    "choropleth",
    "geojson",
    "data-visualization"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apexcharts/apexmaps.git",
    "directory": "wrappers/vue"
  },
  "homepage": "https://github.com/apexcharts/apexmaps/tree/main/wrappers/vue#readme",
  "bugs": {
    "url": "https://github.com/apexcharts/apexmaps/issues"
  },
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@vue/test-utils": "^2.4.11",
    "apexmaps": "file:../..",
    "vue": "^3.5.40"
  }
}
